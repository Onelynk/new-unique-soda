rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Menu drink images: public read access for mobile customers; uploads/deletions restricted to authenticated shop admins
    match /menu/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
